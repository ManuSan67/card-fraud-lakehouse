{
  "datasets": [
    {
      "name": "c42594d5",
      "displayName": "kpis",
      "queryLines": [
        "SELECT\r\n",
        "  COUNT(*)                                           AS transactions,\r\n",
        "  ROUND(SUM(amount), 0)                              AS total_amount_mxn,\r\n",
        "  SUM(CASE WHEN is_fraud THEN 1 ELSE 0 END)          AS fraud_transactions,\r\n",
        "  ROUND(SUM(CASE WHEN is_fraud THEN amount END), 0)  AS fraud_amount_mxn,\r\n",
        "  ROUND(100 * AVG(CASE WHEN is_fraud THEN 1 ELSE 0 END), 2) AS fraud_rate_pct\r\n",
        "FROM fraud_lakehouse.gold.fact_transactions"
      ]
    },
    {
      "name": "a3faa457",
      "displayName": "daily_trend",
      "queryLines": [
        "SELECT\r\n",
        "  d.date,\r\n",
        "  COUNT(*)                                                 AS transactions,\r\n",
        "  SUM(CASE WHEN f.is_fraud THEN 1 ELSE 0 END)              AS fraud_transactions,\r\n",
        "  ROUND(100 * AVG(CASE WHEN f.is_fraud THEN 1 ELSE 0 END), 2) AS fraud_rate_pct\r\n",
        "FROM fraud_lakehouse.gold.fact_transactions f\r\n",
        "JOIN fraud_lakehouse.gold.dim_date d ON f.date_key = d.date_key\r\n",
        "GROUP BY d.date"
      ]
    },
    {
      "name": "d07006cf",
      "displayName": "fraud_by_category",
      "queryLines": [
        "SELECT\r\n",
        "  f.category,\r\n",
        "  c.risk_group,\r\n",
        "  COUNT(*)                                                 AS transactions,\r\n",
        "  SUM(CASE WHEN f.is_fraud THEN 1 ELSE 0 END)              AS fraud_transactions,\r\n",
        "  ROUND(100 * AVG(CASE WHEN f.is_fraud THEN 1 ELSE 0 END), 2) AS fraud_rate_pct\r\n",
        "FROM fraud_lakehouse.gold.fact_transactions f\r\n",
        "JOIN fraud_lakehouse.gold.dim_category c ON f.category = c.category\r\n",
        "GROUP BY f.category, c.risk_group"
      ]
    },
    {
      "name": "4e1c6e1c",
      "displayName": "data_quality",
      "queryLines": [
        "SELECT rule, COUNT(*) AS rejected_rows\r\n",
        "FROM fraud_lakehouse.silver.transactions_quarantine\r\n",
        "LATERAL VIEW explode(failed_rules) AS rule\r\n",
        "GROUP BY rule"
      ]
    },
    {
      "name": "ba9d2d83",
      "displayName": "quality_by_rule",
      "queryLines": [
        "SELECT\r\n",
        "  run_date,\r\n",
        "  expectation,\r\n",
        "  sum(passed_records) AS passed,\r\n",
        "  sum(failed_records) AS failed,\r\n",
        "  round(100 * sum(failed_records) / nullif(sum(passed_records + failed_records), 0), 2) AS failed_pct\r\n",
        "FROM fraud_lakehouse.gold.pipeline_quality_log\r\n",
        "GROUP BY run_date, expectation"
      ]
    },
    {
      "name": "60da471d",
      "displayName": "freshness",
      "queryLines": [
        "SELECT\r\n",
        "  round((unix_timestamp(current_timestamp()) - unix_timestamp(max(_ingested_at))) / 3600, 1) AS hours_since_last_load,\r\n",
        "  max(_ingested_at) AS last_load_at\r\n",
        "FROM fraud_lakehouse.bronze.transactions"
      ]
    }
  ],
